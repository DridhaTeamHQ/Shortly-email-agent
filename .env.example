# Copy to .env and fill in real values. Never commit .env.

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Email sender — pick ONE of the two paths below.

# Option A: SMTP (Gmail, Outlook, any SMTP server).
# For Gmail: enable 2FA, create an App Password at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx     # 16-char Google App Password (no spaces)

# Option B: Resend API
RESEND_API_KEY=YOUR_RESEND_KEY

# Sender shown in the "From" header. For Gmail SMTP use your Gmail address.
FROM_EMAIL=Shortly Dailywrap <dailywrap@shortlyindia.com>

# OpenAI (GPT-4o for summarization)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Dashboard endpoints (set in index.html / hosting layer)
SHORTLY_SCRAPE_ENDPOINT=https://YOUR_PROJECT.functions.supabase.co/scrape-news
SHORTLY_SUMMARIZE_ENDPOINT=https://YOUR_PROJECT.functions.supabase.co/summarize-articles
SHORTLY_LIST_ENDPOINT=https://YOUR_PROJECT.functions.supabase.co/list-articles
SHORTLY_REVIEW_ENDPOINT=https://YOUR_PROJECT.functions.supabase.co/review-article
SHORTLY_DIGEST_ENDPOINT=https://YOUR_PROJECT.functions.supabase.co/send-daily-digest

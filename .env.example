# Copy to .env and fill in real values. Never commit .env.

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Email sender

# Recommended: Amazon SES API
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# Optional fallback: Brevo API key
# SMTP_PASS=YOUR_BREVO_API_KEY

# Sender shown in the "From" header.
FROM_EMAIL=Shortly Dailywrap <dailywrap@shortlyindia.com>

# OpenAI (GPT-4o for summarization)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Dashboard endpoints (set in index.html / hosting layer)
SHORTLY_SCRAPE_ENDPOINT=https://YOUR_PROJECT.functions.supabase.co/scrape-news
SHORTLY_SUMMARIZE_ENDPOINT=https://YOUR_PROJECT.functions.supabase.co/summarize-articles
SHORTLY_CORPORATE_CASE_ENDPOINT=https://YOUR_PROJECT.functions.supabase.co/corporate-case-agent
SHORTLY_LIST_ENDPOINT=https://YOUR_PROJECT.functions.supabase.co/list-articles
SHORTLY_REVIEW_ENDPOINT=https://YOUR_PROJECT.functions.supabase.co/review-article
SHORTLY_DIGEST_ENDPOINT=https://YOUR_PROJECT.functions.supabase.co/send-daily-digest
SHORTLY_SITE_URL=
SHORTLY_X_URL=https://x.com/Shortly_news
SHORTLY_LINKEDIN_URL=https://www.linkedin.com/company/shortly-news/
SHORTLY_AGENT_APP_URL=https://shortlyagents.vercel.app

# Signed token secret used by Shortly Agents -> Email Agent handoff
SHORTLY_AGENT_AUTH_SECRET=YOUR_SHARED_HMAC_SECRET

# Optional fallback for legacy static token validation
SHORTLY_AGENT_SHARED_TOKEN=YOUR_SHARED_LOGIN_TOKEN
